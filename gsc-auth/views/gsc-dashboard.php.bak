}
.gradient-text {
    background: linear-gradient(to right, #a5b4fc, #d8b4fe);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.yali-card {
    background: #fff;
    border-radius: 14px;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
}

/* Metrics Grid */
.yali-gsc-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 25px;
}
.metric-card {
    padding: 25px;
    text-align: center;
    transition: transform 0.2s;
}
.metric-card:hover { transform: translateY(-2px); }
.metric-card .metric-head { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 12px; }
.metric-card h3 { 
    margin: 0; font-size: 0.9em; font-weight: 600; color: #64748b; 
    text-transform: uppercase; letter-spacing: 0.5px; 
}
.metric-icon { font-size: 1.2em; }
.metric-val { font-size: 2.2em; font-weight: 800; color: #1e293b; font-family: 'Inter', sans-serif; }
.metric-card.loading { display: flex; align-items: center; justify-content: center; min-height: 120px; color: #94a3b8; }

/* Tabs Navigation */
.yali-tabs-nav {
    display: flex !important;
    gap: 15px !important;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 0;
    margin-bottom: 20px;
    flex-direction: row !important;
    flex-wrap: wrap !important;
}
.yali-tab-item {
    padding: 12px 20px;
    cursor: pointer;
    font-weight: 600;
    color: #64748b;
    border-bottom: 3px solid transparent;
    transition: all 0.2s;
    font-size: 1.05em;
    display: flex;
    align-items: center;
    gap: 8px;
}
.yali-tab-item:hover { color: #1e293b; }
.yali-tab-item.active {
    color: #4f46e5;
    border-bottom-color: #4f46e5;
}
.yali-tab-pane { display: none; }
.yali-tab-pane.active { display: block; }

/* Site Toolbar */
.yali-gsc-site-badge {
    background: rgba(255,255,255,0.1);
    color: #fff;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.9em;
    font-weight: 500;
    border: 1px solid rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    gap: 8px;
}

/* AI Pack Cards */
.yali-gsc-packs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 25px;
}
.yali-pack-card {
    background: #fff;
    border: 1px solid #f1f5f9;
    border-radius: 16px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.1, 0.7, 0.6, 1);
}
.yali-pack-card:hover {
    box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);
    border-color: #e2e8f0;
}
.pack-badge {
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 0.75em;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: #f1f5f9;
    color: #475569;
    margin-bottom: 15px;
}
.pack-head { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; }
.pack-icon { font-size: 1.4em; }
.pack-head h3 { margin: 0; font-size: 1.2em; font-weight: 700; color: #0f172a; }
.pack-desc { color: #64748b; line-height: 1.6; margin-bottom: 20px; flex: 1; font-size: 0.95em; }
.pack-stats { 
    background: #f8fafc; 
    padding: 12px; 
    border-radius: 10px; 
    font-size: 0.9em; 
    text-align: center; 
    margin-bottom: 20px; 
    border: 1px dashed #e2e8f0;
}
.pack-footer { display: flex; gap: 10px; }
.pack-footer button { flex: 1; }

/* Utilities */
.spin { animation: spin 1.2s linear infinite; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.yali-keywords-scroll {
    max-height: 400px;
    overflow-y: auto;
    padding: 15px;
    background: #f8fafc;
    border-radius: 8px;
