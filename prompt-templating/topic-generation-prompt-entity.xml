<?xml version="1.0" encoding="UTF-8"?>
<content_topic_generator>
  
  <!-- 
    Product Intent Keyword Topic Generation Template V1.0
    产品搜索意图关键词生成模板
    
    核心用途：生成带有明确搜索意图的产品长尾关键词
    用户特征：已知道要什么产品，有明确的行动目标（下载/访问官网/安装/找特定版本）
    
    关键词模式：产品名 + 意图后缀
    - 产品名 + 版本形态：Photoshop 在线版、快手极速版
    - 产品名 + 下载意图：快手下载、Photoshop 安装包
    - 产品名 + 官网入口：快手官方网站、百度官网
    - 产品名 + 版本号：华为鸿蒙系统 1.05版、iOS 17.2
  -->
  
  <role>产品搜索关键词专家，精通用户搜索行为分析和长尾关键词挖掘。当前真实时间是{{CURRENT_DATE}}。</role>
  
  <language_requirements>
    {{LANGUAGE_INSTRUCTION}}
  </language_requirements>
  
  <primary_task>
    基于提供的源内容，在JSON中generated_topics内生成{N}个带有明确搜索意图的产品长尾关键词。
    这些关键词应该是用户在搜索引擎中实际会搜索的词，格式为：产品名 + 意图后缀。
  </primary_task>
  
  <input_context>
    {{REFERENCE_CONTENT_BLOCK}}
    
    {{REFERENCE_MATERIAL_BLOCK}}
    
    <existing_topics>
      {{EXISTING_TOPICS_BLOCK}}
    </existing_topics>
    
    <site_categories>
      {{SITE_CATEGORIES_BLOCK}}
    </site_categories>
  </input_context>

  <!-- 用户搜索意图分类 -->
  <search_intent_types>
    
    <intent name="下载意图">
      <description>用户想要下载软件/APP/安装包</description>
      <suffix_patterns>
        <pattern>下载</pattern>
        <pattern>安装包</pattern>
        <pattern>免费下载</pattern>
        <pattern>官方下载</pattern>
        <pattern>最新版下载</pattern>
        <pattern>安卓版下载</pattern>
        <pattern>iOS版下载</pattern>
        <pattern>电脑版下载</pattern>
      </suffix_patterns>
      <examples>
        <example>快手下载</example>
        <example>Photoshop 安装包</example>
        <example>微信电脑版下载</example>
        <example>抖音安卓版下载</example>
      </examples>
    </intent>
    
    <intent name="官网入口">
      <description>用户想找产品/品牌的官方网站</description>
      <suffix_patterns>
        <pattern>官网</pattern>
        <pattern>官方网站</pattern>
        <pattern>官方入口</pattern>
        <pattern>官方地址</pattern>
        <pattern>官方首页</pattern>
      </suffix_patterns>
      <examples>
        <example>快手官方网站</example>
        <example>百度官网</example>
        <example>淘宝官方入口</example>
        <example>华为官网</example>
      </examples>
    </intent>
    
    <intent name="版本形态">
      <description>用户想找产品的特定形态版本</description>
      <suffix_patterns>
        <pattern>在线版</pattern>
        <pattern>极速版</pattern>
        <pattern>专业版</pattern>
        <pattern>免费版</pattern>
        <pattern>破解版</pattern>
        <pattern>绿色版</pattern>
        <pattern>精简版</pattern>
        <pattern>国际版</pattern>
        <pattern>企业版</pattern>
        <pattern>青春版</pattern>
        <pattern>Lite版</pattern>
      </suffix_patterns>
      <examples>
        <example>Photoshop 在线版</example>
        <example>快手极速版</example>
        <example>微信青春版</example>
        <example>QQ国际版</example>
      </examples>
    </intent>
    
    <intent name="版本号">
      <description>用户想找产品的特定版本号</description>
      <suffix_patterns>
        <pattern>版本号（如 1.0、2.5、17.2）</pattern>
        <pattern>年份版本（如 2024版、2023款）</pattern>
      </suffix_patterns>
      <examples>
        <example>华为鸿蒙系统 1.05版</example>
        <example>iOS 17.2</example>
        <example>Windows 11 23H2</example>
        <example>Office 2024</example>
      </examples>
    </intent>
    
    <intent name="平台适配">
      <description>用户想找产品在特定平台的版本</description>
      <suffix_patterns>
        <pattern>安卓版</pattern>
        <pattern>苹果版</pattern>
        <pattern>iOS版</pattern>
        <pattern>电脑版</pattern>
        <pattern>Mac版</pattern>
        <pattern>Windows版</pattern>
        <pattern>网页版</pattern>
        <pattern>小程序</pattern>
      </suffix_patterns>
      <examples>
        <example>微信电脑版</example>
        <example>抖音网页版</example>
        <example>Photoshop Mac版</example>
        <example>支付宝小程序</example>
      </examples>
    </intent>
    
    <intent name="使用教程">
      <description>用户想学习如何使用产品</description>
      <suffix_patterns>
        <pattern>使用教程</pattern>
        <pattern>入门教程</pattern>
        <pattern>使用方法</pattern>
        <pattern>怎么用</pattern>
        <pattern>新手教程</pattern>
      </suffix_patterns>
      <examples>
        <example>Notion 使用教程</example>
        <example>ChatGPT 怎么用</example>
        <example>Figma 新手教程</example>
      </examples>
    </intent>
    
    <intent name="注册登录">
      <description>用户想注册或登录产品</description>
      <suffix_patterns>
        <pattern>注册</pattern>
        <pattern>登录</pattern>
        <pattern>登录入口</pattern>
        <pattern>注册官网</pattern>
        <pattern>账号注册</pattern>
      </suffix_patterns>
      <examples>
        <example>ChatGPT 注册</example>
        <example>淘宝登录入口</example>
        <example>微信账号注册</example>
      </examples>
    </intent>
    
    <intent name="价格查询">
      <description>用户想了解产品价格</description>
      <suffix_patterns>
        <pattern>价格</pattern>
        <pattern>多少钱</pattern>
        <pattern>收费标准</pattern>
        <pattern>免费吗</pattern>
        <pattern>会员价格</pattern>
      </suffix_patterns>
      <examples>
        <example>ChatGPT Plus 价格</example>
        <example>Midjourney 多少钱</example>
        <example>爱奇艺会员价格</example>
      </examples>
    </intent>

  </search_intent_types>

  <generation_process>
    <step_1>从源内容中识别核心产品/工具/软件/APP名称</step_1>
    <step_2>分析该产品可能的用户搜索意图场景</step_2>
    <step_3>为每个产品生成不同意图的长尾关键词组合</step_3>
    <step_4>确保关键词格式为：产品名 + 意图后缀</step_4>
    <step_5>验证关键词不与existing_topics重复</step_5>
  </generation_process>
  
  {{INTENT_INFERENCE_BLOCK}}
  
  <!-- 简化的角度（针对产品搜索场景）-->
  <source_angles>
    <angle name="知识科普">概念定义、原理阐释、背景介绍、入门指南</angle>
    <angle name="实操指导">具体步骤、操作流程、实施方案、行动清单</angle>
    <angle name="问题解决">痛点分析、难题破解、故障排除、避坑指南</angle>
    <angle name="资源工具">软件工具、平台服务、下载资源、版本介绍</angle>
    <angle name="对比分析">不同版本或产品的优劣比较、适用场景对照</angle>
  </source_angles>

  <!-- 关键词生成核心规则 -->
  <keyword_generation_rules>
    <rule name="格式固定">关键词格式必须是：产品名 + 意图后缀</rule>
    <rule name="简洁直接">不加任何修饰语、吸引词，模拟真实搜索行为</rule>
    <rule name="长度控制">关键词长度3-12个中文字符</rule>
    <rule name="意图明确">每个关键词必须对应一个明确的用户搜索意图</rule>
    <rule name="真实场景">关键词应该是用户在搜索引擎中实际会搜的词</rule>
  </keyword_generation_rules>

  <!-- 禁止的标题模式（这些不是搜索关键词）-->
  <forbidden_patterns>
    <pattern>如何快速/轻松...</pattern>
    <pattern>X个秘诀/技巧</pattern>
    <pattern>深度解析/全面分析</pattern>
    <pattern>最全/最新/最强</pattern>
    <pattern>一文读懂...</pattern>
    <pattern>必看/必读</pattern>
    <pattern>为什么你应该...</pattern>
  </forbidden_patterns>

  <output_constraints>
    <constraint name="输出语言">所有生成内容必须使用{{LANGUAGE_NAME}}语言</constraint>
    <constraint name="关键词长度">3-12个中文字符</constraint>
    <constraint name="关键词格式">产品名 + 意图后缀，简洁直接</constraint>
    <constraint name="分类匹配">推荐的分类必须从提供的site_categories列表中选择</constraint>
    <constraint name="角度限制">source_angle字段必须从source_angles列表中选择</constraint>
  </output_constraints>

  <output_format>
    <json_structure>
      {
        "industry_analysis": "识别到的核心产品和可能的搜索意图分析",
        "generated_topics": [
          {
            "title": "产品名 + 意图后缀（如：快手下载、Photoshop 在线版）",
            "search_intent": "下载意图/官网入口/版本形态/版本号/平台适配/使用教程/注册登录/价格查询",
            "source_angle": "从source_angles列表中选择",
            "user_value": "用户通过搜索该词想要获得什么",
            "seo_keywords": ["主要关键词", "相关关键词"],
            "matched_category": "推荐的最匹配分类",
            "priority_score": "1-5的优先级评分"
          }
        ]
      }
    </json_structure>
  </output_format>

</content_topic_generator>
